# ==============================================================================
# Claude Call Environment Variables Template
# Copy this file to `.env` (which is git-ignored) and customize the values.
# ==============================================================================

# Telnyx Telephony Credentials
TELNYX_API_KEY=KEY_MOCK_TEST
TELNYX_CONNECTION_ID=conn_mock_123
TELNYX_FROM_NUMBER=+15551234567
TELNYX_API_BASE=https://api.telnyx.com/v2

# Database / PostgreSQL Configuration
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/claude_call
TODO_TABLE_NAME=user_todos
TODO_DB_SCHEMA=public
DB_APP_ROLE=claude_call_app
AUTO_APPLY_MIGRATIONS=true

# External Account Keys / Provider Tokens (e.g., Anthropic Claude, OpenAI, etc.)
ANTHROPIC_API_KEY=sk-ant-api03-example-placeholder
OPENAI_API_KEY=sk-proj-example-placeholder

# API Authentication Security for Claude Call API
# Require clients to provide API keys via `X-API-Key` header or `Authorization: Bearer <key>`.
API_KEY_AUTH_ENABLED=false

# Valid API keys for accessing this service (comma-separated).
# Required format: prefix `cc_` followed by environment (`live_` or `test_`) and at least 16 alphanumeric characters.
# Example: cc_live_abcdef1234567890, cc_test_0987654321fedcba
API_KEYS=cc_test_0123456789abcdef0123456789abcdef

#Cloudflair
CLOUDFLAIR_DEPLOY_KEY=cfut_111
CLOUDFLAIR_LOGS_KEY=cfut_222
CLOUDFLAIR_ACCOUNT_ID=61893bc426a76ba019cfd16ede881a14